# ============================================
# Chain Risk Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# ==================== Docker Host ====================
# IP address of the machine running docker-compose
DOCKER_HOST_IP=localhost

# ==================== Database ====================
POSTGRES_HOST=${DOCKER_HOST_IP}
POSTGRES_PORT=15432
POSTGRES_USER=chainrisk
POSTGRES_PASSWORD=chainrisk123
POSTGRES_DB=chainrisk

# Neo4j
NEO4J_HOST=${DOCKER_HOST_IP}
NEO4J_PORT=17687
NEO4J_URI=bolt://${DOCKER_HOST_IP}:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chainrisk123

# Redis
REDIS_HOST=${DOCKER_HOST_IP}
REDIS_PORT=16379
REDIS_PASSWORD=

# ==================== Message Queue ====================
KAFKA_BROKERS=${DOCKER_HOST_IP}:19092
KAFKA_GROUP_ID=chain-risk-platform

# ==================== Service Discovery ====================
NACOS_SERVER=${DOCKER_HOST_IP}:18848
NACOS_NAMESPACE=public
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ==================== Data Lake ====================
MINIO_ENDPOINT=http://${DOCKER_HOST_IP}:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
TRINO_HOST=${DOCKER_HOST_IP}
TRINO_PORT=18081

# ==================== Monitoring ====================
JAEGER_ENDPOINT=http://${DOCKER_HOST_IP}:14268/api/traces
PROMETHEUS_PUSHGATEWAY=http://${DOCKER_HOST_IP}:19091

# ==================== Service Ports ====================
QUERY_SERVICE_PORT=8081
RISK_SERVICE_PORT=8082
ORCHESTRATOR_PORT=8083
GRAPH_SERVICE_PORT=8084
ALERT_SERVICE_PORT=8085
BFF_PORT=3001

# ==================== Data Retention ====================
# PostgreSQL partition retention (days)
TRANSFERS_RETENTION_DAYS=7
TRANSACTIONS_RETENTION_DAYS=7
ALERTS_RETENTION_DAYS=30

# Neo4j TTL (days)
NEO4J_RETENTION_DAYS=7

# Future partitions to pre-create
PARTITION_DAYS_AHEAD=3

# ==================== External APIs ====================
ETHERSCAN_API_KEY=your_etherscan_api_key

# ==================== Environment ====================
NODE_ENV=development
GO_ENV=development
SPRING_PROFILES_ACTIVE=dev
