{
  "openapi": "3.0.1",
  "info": {
    "title": "Chain Risk Platform - Orchestrator API",
    "description": "API Gateway and Orchestration layer for Chain Risk Platform.",
    "contact": {
      "name": "Chain Risk Team",
      "email": "chainrisk@example.com"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Admin API",
      "description": "Pipeline administration and monitoring"
    },
    {
      "name": "Orchestration",
      "description": "Aggregated endpoints that combine multiple API calls for complex queries"
    }
  ],
  "paths": {
    "/api/v1/orchestration/batch-risk-analysis": {
      "post": {
        "tags": ["Orchestration"],
        "summary": "Batch address risk analysis",
        "description": "Performs risk analysis for multiple addresses in a single request",
        "operationId": "batchRiskAnalysis",
        "requestBody": {
          "description": "List of addresses to analyze",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRiskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Batch analysis completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchRiskResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/admin/pipeline/ingestion/{action}": {
      "post": {
        "tags": ["Admin API"],
        "summary": "Control data ingestion",
        "description": "Pause or resume data ingestion",
        "operationId": "controlIngestion",
        "parameters": [
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["pause", "resume"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orchestration/high-risk-network": {
      "get": {
        "tags": ["Orchestration"],
        "summary": "Get high-risk network analysis",
        "description": "Retrieves addresses with risk scores above the specified threshold",
        "operationId": "getHighRiskNetwork",
        "parameters": [
          {
            "name": "threshold",
            "in": "query",
            "description": "Risk score threshold (0.0 - 1.0)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "default": 0.7
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of addresses to return",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "High-risk network analysis completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HighRiskNetworkResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/orchestration/connection/{fromAddress}/{toAddress}": {
      "get": {
        "tags": ["Orchestration"],
        "summary": "Find connection between addresses",
        "description": "Finds the shortest path between two addresses and provides risk analysis for both endpoints",
        "operationId": "findConnection",
        "parameters": [
          {
            "name": "fromAddress",
            "in": "path",
            "description": "Source address (0x-prefixed)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "toAddress",
            "in": "path",
            "description": "Target address (0x-prefixed)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxDepth",
            "in": "query",
            "description": "Maximum path depth to search",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 5
            }
          },
          {
            "name": "network",
            "in": "query",
            "description": "Blockchain network",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ethereum"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connection analysis completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/orchestration/address-profile/{address}": {
      "get": {
        "tags": ["Orchestration"],
        "summary": "Get address profile",
        "description": "Orchestrates multiple API calls to get a comprehensive address profile including basic info, risk score, and recent transfers",
        "operationId": "getAddressProfile",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "description": "Blockchain address (0x-prefixed)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "network",
            "in": "query",
            "description": "Blockchain network",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ethereum"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Address profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/orchestration/address-analysis/{address}": {
      "get": {
        "tags": ["Orchestration"],
        "summary": "Get comprehensive address analysis",
        "description": "Orchestrates multiple API calls to get comprehensive address analysis including basic info, risk score, graph data, neighbors, tags, and cluster information",
        "operationId": "getAddressAnalysis",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "description": "Blockchain address (0x-prefixed)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "network",
            "in": "query",
            "description": "Blockchain network",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ethereum"
            }
          },
          {
            "name": "neighborDepth",
            "in": "query",
            "description": "Neighbor search depth (1-3)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "neighborLimit",
            "in": "query",
            "description": "Maximum number of neighbors to return",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Address analysis retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressAnalysisResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/admin/services": {
      "get": {
        "tags": ["Admin API"],
        "summary": "List all registered services",
        "description": "Returns all services registered in Nacos",
        "operationId": "getServices",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServiceInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/services/{serviceName}": {
      "get": {
        "tags": ["Admin API"],
        "summary": "Get service instances",
        "description": "Returns all instances of a specific service",
        "operationId": "getServiceInstances",
        "parameters": [
          {
            "name": "serviceName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServiceInstance"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/pipeline/status": {
      "get": {
        "tags": ["Admin API"],
        "summary": "Get pipeline status",
        "description": "Returns aggregated status of all pipeline components",
        "operationId": "getPipelineStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/config/risk": {
      "get": {
        "tags": ["Admin API"],
        "summary": "Get risk configuration",
        "description": "Returns current risk scoring configuration from Nacos",
        "operationId": "getRiskConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskProperties"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/config/pipeline": {
      "get": {
        "tags": ["Admin API"],
        "summary": "Get pipeline configuration",
        "description": "Returns current pipeline configuration from Nacos",
        "operationId": "getPipelineConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineProperties"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/config/all": {
      "get": {
        "tags": ["Admin API"],
        "summary": "Get all configurations",
        "description": "Returns all configurations from Nacos",
        "operationId": "getAllConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllConfigResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchRiskRequest": {
        "type": "object",
        "required": ["addresses"],
        "properties": {
          "addresses": {
            "type": "array",
            "description": "List of addresses to analyze",
            "items": {
              "type": "string"
            }
          },
          "network": {
            "type": "string",
            "description": "Blockchain network",
            "default": "ethereum"
          }
        }
      },
      "BatchRiskResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RiskScoreResponse"
            }
          },
          "total": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          }
        }
      },
      "RiskScoreResponse": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "riskScore": {
            "type": "number"
          },
          "riskLevel": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "factors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RiskFactor"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evaluatedAt": {
            "type": "string"
          },
          "cached": {
            "type": "boolean"
          }
        }
      },
      "RiskFactor": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "weight": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "triggered": {
            "type": "boolean"
          }
        }
      },
      "HighRiskNetworkResponse": {
        "type": "object",
        "properties": {
          "threshold": {
            "type": "number"
          },
          "count": {
            "type": "integer"
          },
          "highRiskAddresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphAddressInfo"
            }
          },
          "orchestratedAt": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GraphAddressInfo": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "firstSeen": {
            "type": "string"
          },
          "lastSeen": {
            "type": "string"
          },
          "txCount": {
            "type": "integer"
          },
          "riskScore": {
            "type": "number"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "clusterId": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "incomingCount": {
            "type": "integer"
          },
          "outgoingCount": {
            "type": "integer"
          }
        }
      },
      "ConnectionResponse": {
        "type": "object",
        "properties": {
          "fromAddress": {
            "type": "string"
          },
          "toAddress": {
            "type": "string"
          },
          "path": {
            "$ref": "#/components/schemas/PathResponse"
          },
          "fromAddressRisk": {
            "$ref": "#/components/schemas/RiskScoreResponse"
          },
          "toAddressRisk": {
            "$ref": "#/components/schemas/RiskScoreResponse"
          },
          "orchestratedAt": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PathResponse": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "fromAddress": {
            "type": "string"
          },
          "toAddress": {
            "type": "string"
          },
          "pathLength": {
            "type": "integer"
          },
          "maxDepth": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PathNode"
            }
          }
        }
      },
      "PathNode": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "txHash": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "riskScore": {
            "type": "number"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AddressProfileResponse": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "addressInfo": {
            "$ref": "#/components/schemas/AddressInfo"
          },
          "riskScore": {
            "$ref": "#/components/schemas/RiskScoreResponse"
          },
          "recentTransfers": {
            "$ref": "#/components/schemas/PaginatedTransfers"
          },
          "orchestratedAt": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AddressInfo": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "firstSeen": {
            "type": "string"
          },
          "lastSeen": {
            "type": "string"
          },
          "totalTxCount": {
            "type": "integer"
          },
          "sentTxCount": {
            "type": "integer"
          },
          "receivedTxCount": {
            "type": "integer"
          },
          "uniqueInteracted": {
            "type": "integer"
          }
        }
      },
      "PaginatedTransfers": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transfer"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Transfer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "txHash": {
            "type": "string"
          },
          "blockNumber": {
            "type": "integer"
          },
          "fromAddress": {
            "type": "string"
          },
          "toAddress": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "transferType": {
            "type": "string"
          },
          "network": {
            "type": "string"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "AddressAnalysisResponse": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "basic": {
            "$ref": "#/components/schemas/BasicAnalysis"
          },
          "graph": {
            "$ref": "#/components/schemas/GraphAnalysis"
          },
          "orchestratedAt": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BasicAnalysis": {
        "type": "object",
        "properties": {
          "addressInfo": {
            "$ref": "#/components/schemas/AddressInfo"
          },
          "riskScore": {
            "$ref": "#/components/schemas/RiskScoreResponse"
          }
        }
      },
      "GraphAnalysis": {
        "type": "object",
        "properties": {
          "graphInfo": {
            "$ref": "#/components/schemas/GraphAddressInfo"
          },
          "neighbors": {
            "$ref": "#/components/schemas/AddressNeighborsResponse"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cluster": {
            "$ref": "#/components/schemas/ClusterResponse"
          }
        }
      },
      "AddressNeighborsResponse": {
        "type": "object",
        "description": "Subgraph of address neighbors with nodes and edges (same as BFF)",
        "properties": {
          "address": {
            "type": "string",
            "description": "Center address"
          },
          "depth": {
            "type": "integer",
            "description": "Search depth used"
          },
          "nodes": {
            "type": "array",
            "description": "Nodes in the subgraph",
            "items": {
              "$ref": "#/components/schemas/GraphNode"
            }
          },
          "edges": {
            "type": "array",
            "description": "Edges in the subgraph",
            "items": {
              "$ref": "#/components/schemas/GraphEdge"
            }
          }
        },
        "required": ["address", "nodes", "edges"]
      },
      "GraphNode": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "distance": {
            "type": "integer",
            "description": "Distance from center node"
          },
          "riskScore": {
            "type": "number"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "firstSeen": {
            "type": "string"
          },
          "lastSeen": {
            "type": "string"
          }
        }
      },
      "GraphEdge": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "transferCount": {
            "type": "integer"
          },
          "totalValue": {
            "type": "string"
          },
          "lastTransfer": {
            "type": "string"
          }
        }
      },
      "ClusterResponse": {
        "type": "object",
        "properties": {
          "clusterId": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "riskScore": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "network": {
            "type": "string"
          }
        }
      },
      "ActionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ServiceInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "groupName": {
            "type": "string"
          },
          "clusterCount": {
            "type": "integer"
          },
          "instanceCount": {
            "type": "integer"
          },
          "healthyInstanceCount": {
            "type": "integer"
          }
        }
      },
      "ServiceInstance": {
        "type": "object",
        "properties": {
          "instanceId": {
            "type": "string"
          },
          "ip": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "healthy": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "PipelineStatus": {
        "type": "object",
        "properties": {
          "ingestion": {
            "$ref": "#/components/schemas/IngestionStatus"
          },
          "streamProcessor": {
            "$ref": "#/components/schemas/StreamProcessorStatus"
          },
          "clustering": {
            "$ref": "#/components/schemas/ComponentStatus"
          },
          "propagation": {
            "$ref": "#/components/schemas/ComponentStatus"
          }
        }
      },
      "IngestionStatus": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
