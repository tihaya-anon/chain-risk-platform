{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": ["chain-risk"],
      "targetBlank": true,
      "title": "Related Dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "📊 Service Overview (RED Metrics)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Requests per second across all services",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "req/s", "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "pointSize": 5, "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(query_service_http_requests_total[5m])) by (job)", "legendFormat": "query-service", "refId": "A" },
        { "expr": "sum(rate(risk_ml_service_http_requests_total[5m])) by (job)", "legendFormat": "risk-ml-service", "refId": "B" },
        { "expr": "sum(rate(alert_service_http_requests_total[5m])) by (job)", "legendFormat": "alert-service", "refId": "C" }
      ],
      "title": "Request Rate (R)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Error rate percentage",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "%", "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] },
          "unit": "percent",
          "max": 100
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "100 * sum(rate(query_service_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(query_service_http_requests_total[5m]))", "legendFormat": "query-service", "refId": "A" },
        { "expr": "100 * sum(rate(risk_ml_service_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(risk_ml_service_http_requests_total[5m]))", "legendFormat": "risk-ml-service", "refId": "B" },
        { "expr": "100 * sum(rate(alert_service_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(alert_service_http_requests_total[5m]))", "legendFormat": "alert-service", "refId": "C" }
      ],
      "title": "Error Rate (E)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "P95 latency in milliseconds",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "ms", "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(query_service_http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "query-service P95", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(risk_ml_service_http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "risk-ml-service P95", "refId": "B" },
        { "expr": "histogram_quantile(0.95, sum(rate(alert_service_http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "alert-service P95", "refId": "C" }
      ],
      "title": "Duration P95 (D)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "panels": [],
      "title": "📝 Log Analysis",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Log volume by level",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 70, "lineWidth": 0, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*ERROR.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*WARN.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*INFO.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "right" } },
      "targets": [
        { "expr": "sum by (level) (count_over_time({job=~\".*service.*\"} | json [1m]))", "legendFormat": "{{level}}", "refId": "A" }
      ],
      "title": "Log Volume by Level",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Error logs from all services",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "id": 11,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showLabels": true, "showTime": true, "wrapLogMessage": true },
      "targets": [
        { "expr": "{job=~\".*service.*\"} |= \"ERROR\" | json", "refId": "A" }
      ],
      "title": "Recent Errors",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Search logs with trace correlation",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "id": 12,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showLabels": true, "showTime": true, "wrapLogMessage": true },
      "targets": [
        { "expr": "{job=~\".*service.*\"} | json | line_format \"{{.timestamp}} [{{.level}}] {{.service}} - {{.message}} {{if .trace_id}}[trace={{.trace_id}}]{{end}}\"", "refId": "A" }
      ],
      "title": "Log Stream (click trace_id to view trace)",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 102,
      "panels": [],
      "title": "🔍 Trace Analysis",
      "type": "row"
    },
    {
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "description": "Service dependency map from traces",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 20,
      "options": {},
      "targets": [
        { "query": "risk-ml-service", "queryType": "dependencyGraph", "refId": "A" }
      ],
      "title": "Service Dependencies",
      "type": "nodeGraph"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Trace duration distribution",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 21,
      "options": { "bucketOffset": 0, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(risk_ml_service_risk_score_latency_seconds_bucket[5m])) by (le)", "format": "heatmap", "legendFormat": "{{le}}", "refId": "A" }
      ],
      "title": "ML Inference Duration Heatmap",
      "type": "heatmap"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["chain-risk", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Unified Observability",
  "uid": "unified-observability"
}
