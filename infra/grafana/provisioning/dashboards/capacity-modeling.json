    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Throughput per unit concurrency - should stay relatively flat for good scalability",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "id": 21,
      "targets": [
        {
          "expr": "query_service:usl_throughput / clamp_min(query_service:usl_concurrency, 1)",
          "legendFormat": "query-service",
          "refId": "A"
        },
        {
          "expr": "risk_ml_service:usl_throughput / clamp_min(risk_ml_service:usl_concurrency, 1)",
          "legendFormat": "risk-ml-service",
          "refId": "B"
        },
        {
          "expr": "graph_service:usl_throughput / clamp_min(graph_service:usl_concurrency, 1)",
          "legendFormat": "graph-service",
          "refId": "C"
        }
      ],
      "title": "Throughput per Concurrency Unit (λ estimate)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "P99 latency should stay stable; increases indicate saturation",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 },
